# Скопировать в .env и заполнить при необходимости.
# Реальных секретов сюда не коммитить.

POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_DB=production_monitoring
POSTGRES_PORT=5432

# Строка подключения для приложения (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://monitoring:monitoring@localhost:5432/production_monitoring
